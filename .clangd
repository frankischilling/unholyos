CompileFlags:
  Add: [-std=c++20, -Wall, -Wextra]

---
If:
  PathMatch: '[Kk]ernel/.*'
CompileFlags:
  Add:
    - --target=x86_64-unknown-linux-gnu
    - -ffreestanding
    - -fno-pie
    - -fno-exceptions
    - -fno-rtti
    - -fno-stack-protector
    - -fno-asynchronous-unwind-tables
    - -mno-red-zone
    - -mgeneral-regs-only
