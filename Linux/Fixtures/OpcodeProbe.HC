asm {
  USE16
_OPCODE_16::
  NOP2
  PUSHFW
  CWD
  MOV AX,[BX]
  RET

  USE32
_OPCODE_32::
  NOP2
  PUSHFW
  CWD
  MOV AX,[BX]
  RET

  USE64
_OPCODE_INT::
  MOV RAX,0x108
  BSF RDX,RAX
  BSR R8,RAX
  XCHG RDX,R8
  BT RAX,8
  MOV RAX,0
  SETC AL
  SHL RAX,4
  ADD RAX,RDX
  ADD RAX,R8
  CMP RAX,27
  MOV R9,42
  CMOVZ RAX,R9
  RET

_OPCODE_X87::
  FLD1
  FLD1
  FADDP ST1,ST0
  SUB RSP,8
  FISTP I64 [RSP]
  POP RAX
  RET

_OPCODE_LOOP::
  MOV RCX,2
  XOR RAX,RAX
@@again:
  LEA RAX,1[RAX]
  LOOPZ @@again
  RET

_OPCODE_ADDR::
  PUSH RBP
  MOV RBP,RSP
  SUB RSP,32
  MOV RAX,19
  MOV U64 -16[RBP],RAX
  MOV RAX,23
  MOV U64 -8[RBP],RAX
  LEA RDX,-16[RBP]
  MOV R8,1
  MOV RAX,U64 [RDX+R8*8]
  ADD RAX,U64 [RDX]
  LEAVE
  RET

_OPCODE_SEG::
  MOV RAX,GS:U64 [RDX+R8*8]
  MOV EAX,FS:U32 [EDX+ECX*4]
  RET
}
"opcode table %d %d %d %d\n",
  Call(_OPCODE_INT),Call(_OPCODE_X87),Call(_OPCODE_LOOP),Call(_OPCODE_ADDR);
